#!/usr/bin/env sh
# fastdash pre-commit gate.
#
# The Rust checks run only when Rust files are staged, so a docs-only commit
# stays fast. Anything that fails aborts the commit; fix the reported issue (or
# `git commit --no-verify` to bypass in a genuine emergency).

set -e

staged() {
  git diff --cached --name-only --diff-filter=ACMR
}

rs_files=$(staged | grep -E '\.(rs|toml)$' || true)

# Rust: formatting check + clippy with warnings as errors, over the whole
# workspace (run from the repo root, where the workspace manifest lives).
if [ -n "$rs_files" ]; then
  echo "pre-commit: cargo fmt --check + clippy"
  cargo fmt --all -- --check || {
    echo "  Rust is not formatted. Run 'cargo fmt --all' and re-stage."
    exit 1
  }
  cargo clippy --workspace --all-targets --all-features -- -D warnings
fi
