# dependencies
/node_modules

# frontend build output
/dist

# rust build output
/src-tauri/target

# tauri generated schemas
/src-tauri/gen/schemas

# secrets / local env (never commit)
.env
*.local
.envrc
.direnv/

# updater signing key - the private half must never be committed. The glob also
# covers backups (fastdash.key.bak-*), which the two exact names missed - one
# `git add -A` away from publishing the key that signs every release.
fastdash.key*

# logs / os cruft
*.log
.DS_Store
Thumbs.db
