# repo tooling (git hooks, commitlint)
/node_modules

# rust build output (the workspace target dir)
/target

# wrangler
/cloudflare/node_modules
/.wrangler

# release staging (installer, zip, manifest) built by the release workflow
/dist

# secrets / local env (never commit)
.env
*.local
.envrc
.direnv/

# updater signing key - the private half must never be committed. The glob also
# covers backups (fastdash.key.bak-*), which the two exact names missed - one
# `git add -A` away from publishing the key that signs every release.
fastdash.key*

# logs / os cruft
*.log
.DS_Store
Thumbs.db
