{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "fastdash",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "859a44268d2e4586bd99f1cbbe039e27",
      "preview_id": "d96bc060925c4206aa4e785c144b63ee"
    }
  ]
}
