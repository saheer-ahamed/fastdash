{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "fastdash",
  "main": "cloudflare/src/index.js",
  "preview_urls": false,
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "replace-with-wrangler-kv-namespace-create",
      "preview_id": "replace-with-wrangler-kv-namespace-create"
    }
  ]
}
